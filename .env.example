# Flexmls Spark API credentials (https://sparkplatform.com/docs/api_services/read_first)
# Obtain a Datamart/IDX API key from your MLS admin via the Spark API Developer Portal.
# Leave SPARK_API_KEY unset to run the site against built-in mock listings.
SPARK_API_KEY=
SPARK_API_BASE=https://sparkapi.com/v1

# Required by Spark API terms: identify the consuming application.
SPARK_USER_AGENT=RelocationExpertArizona/1.0

PORT=3000

# Follow Up Boss CRM (https://docs.followupboss.com/reference/events-post)
# Get an API key from Follow Up Boss under Admin > API.
# Leave FUB_API_KEY unset to log leads locally (var/leads.log.jsonl) only.
FUB_API_KEY=
FUB_API_BASE=https://api.followupboss.com/v1
# Optional: only needed if FUB issued you a registered system name/key
# (see docs.followupboss.com "Start Here" for registering a system).
FUB_SYSTEM=
FUB_SYSTEM_KEY=
FUB_SOURCE_NAME=Relocation Expert Arizona Website
