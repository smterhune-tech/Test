<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= community.name %> Homes for Sale | Terhune Realty Partners</title>
<meta name="description" content="Browse <%= community.name %> homes for sale, median price trends, schools, and local market stats from Terhune Realty Partners.">
<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>&#127968;</text></svg>">
<link rel="stylesheet" href="/css/styles.css">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {"@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.terhunerealtypartners.com/"},
    {"@type": "ListItem", "position": 2, "name": "Communities", "item": "https://www.terhunerealtypartners.com/#communities"},
    {"@type": "ListItem", "position": 3, "name": "<%= community.name %>", "item": "https://www.terhunerealtypartners.com/community/<%= community.slug %>"}
  ]
}
</script>
</head>
<body>

<header class="site-header" id="site-header">
  <div class="header-inner">
    <a href="/index.html" class="logo">Terhune <span>Realty Partners</span></a>
    <nav class="main-nav" id="main-nav">
      <a href="/index.html#search">Buy</a>
      <a href="/index.html#communities">Communities</a>
      <a href="/index.html#valuation">Sell / Home Value</a>
      <a href="/index.html#about">About</a>
      <a href="/index.html#video">Market Updates</a>
      <a href="/index.html#contact">Contact</a>
    </nav>
    <div class="header-actions">
      <a href="tel:+15125550142" class="phone-link">(512) 555-0142</a>
      <a href="/index.html#valuation" class="btn btn-primary">Get My Home Value</a>
      <button class="nav-toggle" id="nav-toggle" aria-label="Toggle navigation" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<main>
  <section class="community-hero">
    <div class="section-inner">
      <p class="breadcrumb"><a href="/index.html">Home</a> &rsaquo; <a href="/index.html#communities">Communities</a> &rsaquo; <%= community.name %></p>
      <h1><%= community.name %> Homes for Sale</h1>
      <p class="hero-sub"><%= community.sub %></p>
    </div>
  </section>

  <section class="section community-stats-section">
    <div class="section-inner">
      <div class="authority-inner">
        <div class="authority-stat"><strong><%= community.median %></strong><span>Median list price</span></div>
        <div class="authority-stat"><strong><%= community.active %></strong><span>Active listings</span></div>
        <div class="authority-stat"><strong><%= community.dom %></strong><span>Median days on market</span></div>
        <div class="authority-stat"><strong><%= community.walk %></strong><span>Walk Score</span></div>
      </div>
    </div>
  </section>

  <section class="section listings-section">
    <div class="section-inner">
      <div class="section-heading">
        <h2>Current <%= community.name %> Listings</h2>
      </div>
      <div class="listing-grid" data-community="<%= community.slug %>"></div>
    </div>
  </section>

  <section class="section community-about-section">
    <div class="section-inner community-about-inner">
      <div>
        <h2>About <%= community.name %></h2>
        <p><%= community.about %></p>
        <h3>Schools</h3>
        <p><%= community.schools %></p>
        <h3>Commute</h3>
        <p><%= community.commute %></p>
      </div>
      <div class="community-valuation-cta">
        <h3>Own in <%= community.name %>?</h3>
        <p>Get an instant estimate of your home&rsquo;s current value.</p>
        <a href="/index.html#valuation" class="btn btn-primary">Get My Home Value</a>
      </div>
    </div>
  </section>

  <section class="section video-section">
    <div class="section-inner">
      <div class="section-heading">
        <h2><%= community.videoTitle %></h2>
      </div>
      <div class="video-grid">
        <div class="video-card">
          <div class="video-thumb" data-video-title="<%= community.videoTitle %>"></div>
          <p><%= community.videoTitle %></p>
        </div>
      </div>
    </div>
  </section>
</main>

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-col">
      <h4>Terhune Realty Partners</h4>
      <p>123 Congress Ave, Suite 400<br>Austin, TX 78701</p>
      <p><a href="tel:+15125550142">(512) 555-0142</a><br><a href="mailto:hello@terhunerealtypartners.com">hello@terhunerealtypartners.com</a></p>
    </div>
    <div class="footer-col">
      <h4>Communities</h4>
      <ul>
        <% allCommunities.forEach(function (c) { %>
        <li><a href="/community/<%= c.slug %>"><%= c.name %></a></li>
        <% }); %>
      </ul>
    </div>
    <div class="footer-col">
      <h4>Company</h4>
      <ul>
        <li><a href="/index.html#about">About</a></li>
        <li><a href="/index.html#video">Market Updates</a></li>
        <li><a href="/index.html#valuation">Home Value</a></li>
        <li><a href="/index.html#search">Search Homes</a></li>
      </ul>
    </div>
    <div class="footer-col">
      <h4>Follow</h4>
      <ul class="social-links">
        <li><a href="#">Instagram</a></li>
        <li><a href="#">YouTube</a></li>
        <li><a href="#">Facebook</a></li>
      </ul>
    </div>
  </div>
  <div class="footer-bottom">
    <p>&copy; 2026 Terhune Realty Partners. Equal Housing Opportunity. Information deemed reliable but not guaranteed. IDX/MLS data provided for consumers' personal, non-commercial use.</p>
  </div>
</footer>

<div class="mobile-sticky-cta">
  <a href="tel:+15125550142" class="btn btn-secondary">Call</a>
  <a href="/index.html#valuation" class="btn btn-primary">Get My Home Value</a>
</div>

<!-- EXIT-INTENT MODAL -->
<div class="modal-overlay is-hidden" id="exit-modal-overlay">
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="exit-modal-title">
    <button class="modal-close" id="exit-modal-close" aria-label="Close">&times;</button>
    <h3 id="exit-modal-title">Before You Go &mdash; What&rsquo;s Your Home Worth?</h3>
    <p>Get a free instant estimate. Takes under 2 minutes.</p>
    <a href="/index.html#valuation" class="btn btn-primary" id="exit-modal-cta">Get My Free Estimate</a>
  </div>
</div>

<!-- SOFT REGISTRATION GATE MODAL (triggered after viewing listings) -->
<div class="modal-overlay is-hidden" id="gate-modal-overlay">
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="gate-modal-title">
    <button class="modal-close" id="gate-modal-close" aria-label="Close">&times;</button>
    <h3 id="gate-modal-title">Register to See Full Listing Details</h3>
    <p>Create a free account to unlock full listing photos, price history, and save your favorites.</p>
    <form id="gate-form">
      <input type="text" placeholder="Full Name" required>
      <input type="email" placeholder="Email" required>
      <button type="submit" class="btn btn-primary">Continue</button>
    </form>
    <button class="text-link" id="gate-modal-skip">Not now</button>
  </div>
</div>

<!-- LISTING DETAIL MODAL -->
<div class="modal-overlay is-hidden" id="listing-modal-overlay">
  <div class="modal modal-listing" role="dialog" aria-modal="true" aria-labelledby="listing-modal-title">
    <button class="modal-close" id="listing-modal-close" aria-label="Close">&times;</button>
    <div id="listing-modal-body"><p class="listing-loading">Loading&hellip;</p></div>
  </div>
</div>

<script src="/js/main.js"></script>
</body>
</html>
